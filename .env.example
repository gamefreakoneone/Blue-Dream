# Copy this file to .env and fill in only the providers you use.
# Never commit real keys, tokens, credentials, email addresses, or patient locations.

# Core local services
MONGODB_URI=mongodb://localhost:27017
TIMEZONE=America/Los_Angeles
# Blank uses the repository root. If set, use an absolute directory path.
MEDIA_ROOT=
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_TEXT_MODEL=gemma4:e2b
GEMMA_VISION_MODEL=gemma4:e2b

# Gemini video analysis and spatial localization
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3-flash-preview
GEMINI_VIDEO_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_VIDEO_MAX_RETRIES=3
GEMINI_VIDEO_RETRY_BASE_SECONDS=4
VIDEO_ANALYSIS_TIMEOUT_SECONDS=300
GEMINI_SPATIAL_MODEL=

# Audio transcription
OPENAI_TRANSCRIBE_API_KEY=
# Backward-compatible transcription fallback only.
OPENAI_API_KEY=

# Semantic retrieval
EMBEDDING_PROVIDER=ollama
LOCAL_EMBEDDING_MODEL=nomic-embed-text
CHROMA_EMBEDDING_DIMENSION=768
# Blank uses the repository-root Storage/chroma directory. If set, use an absolute path.
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=memory_events
SEMANTIC_SEARCH_TOP_K=5

# Safety and patient alerts
SAFETY_AGENT_ENABLED=true
SAFETY_ALERT_MIN_SEVERITY=medium
FALL_ALERT_RECIPIENT_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_ANDROID_PACKAGE=

# Patient geofence. Keep real coordinates in the untracked .env file only.
PATIENT_HOME_LAT=
PATIENT_HOME_LNG=
PATIENT_GEOFENCE_RADIUS_METERS=100

# Optional legacy Bedrock/Nova paths
BEDROCK_AWS_REGION=us-east-1
BEDROCK_API_KEY_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
NOVA_ROUTER_MODEL=us.amazon.nova-2-lite-v1:0
NOVA_SYNTHESIS_MODEL=us.amazon.nova-2-lite-v1:0
NOVA_VISION_MODEL=us.amazon.nova-2-lite-v1:0
NOVA_VISION_FALLBACK_MODEL=us.amazon.nova-lite-v1:0
NOVA_EMBEDDING_MODEL=amazon.nova-2-multimodal-embeddings-v1:0
