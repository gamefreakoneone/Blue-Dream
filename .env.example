# Copy this file to .env and fill in only the providers you use.
# Never commit real keys, tokens, credentials, email addresses, or patient locations.

# Core services and provider selection
MONGODB_URI=mongodb://localhost:27017
TIMEZONE=America/Los_Angeles
# Blank uses the repository root. If set, use an absolute directory path.
MEDIA_ROOT=
LLM_PROVIDER=qwen
# Blank defaults to LLM_PROVIDER.
EMBEDDING_PROVIDER=
VIDEO_PROVIDER=qwen
SPATIAL_PROVIDER=qwen
TRANSCRIBE_PROVIDER=qwen
TTS_PROVIDER=none

# OpenAI-compatible provider endpoints and credentials
DASHSCOPE_API_KEY=
# Backward-compatible DashScope key name used by existing local environments.
QWEN_APIKEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
# Optional dedicated key retained for the existing OpenAI transcription fallback.
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# Optional per-task model overrides; blank uses the provider preset.
LLM_TEXT_MODEL=
LLM_SYNTHESIS_MODEL=
LLM_VISION_MODEL=
LLM_SPATIAL_MODEL=
LLM_VIDEO_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=
LLM_TRANSCRIBE_MODEL=
LLM_TTS_MODEL=
EMBED_BATCH_SIZE=10
LLM_DEFAULT_TEMPERATURE=0.1
LLM_DEFAULT_MAX_TOKENS=1200
LLM_REQUEST_TIMEOUT_SECONDS=120

# Gemini full-video analysis and spatial localization are Qwen fallbacks.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3-flash-preview
GEMINI_VIDEO_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_VIDEO_MAX_RETRIES=3
GEMINI_VIDEO_RETRY_BASE_SECONDS=4
VIDEO_ANALYSIS_TIMEOUT_SECONDS=300
GEMINI_SPATIAL_MODEL=

# Private OSS transfer bridge for Qwen URL-video input. Local Storage remains authoritative.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=memoria
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
OSS_PRESIGN_TTL_SECONDS=3600

# Semantic retrieval. Collection names are derived from provider/model/dimension.
# Blank uses the repository-root Storage/chroma directory; otherwise use an absolute path.
CHROMA_PERSIST_DIR=
SEMANTIC_SEARCH_TOP_K=5

# Local capture pipeline. Camera indices and room mappings are comma-separated.
CAMERA_INDICES=1,2
CAMERA_ROOM_MAP=1:0,2:1
# Blank uses Capture/trained-weights/best.pt relative to this repository.
FALL_MODEL_PATH=
CAMERA_FRAME_WIDTH=1920
CAMERA_FRAME_HEIGHT=1080
CAMERA_FPS=20
# Tuned debounce/fall-detection defaults; change only for hardware calibration.
DETECTION_CONFIDENCE_THRESHOLD=0.50
DETECTION_BUFFER_SECONDS=2
FALL_STABILITY_SECONDS=3.5

# Safety and patient alerts
SAFETY_AGENT_ENABLED=true
SAFETY_ALERT_MIN_SEVERITY=medium
FALL_ALERT_RECIPIENT_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_ANDROID_PACKAGE=

# Patient geofence. Keep real coordinates in the untracked .env file only.
PATIENT_HOME_LAT=
PATIENT_HOME_LNG=
PATIENT_GEOFENCE_RADIUS_METERS=100
